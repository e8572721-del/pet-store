  "dependencies": {
    "@craco/craco": "^6.4.3",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "classnames": "^2.3.1",
    "fuse.js": "^6.5.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^6.2.1",
    "react-scripts": "4.0.3",
    "sass": "^1.49.8",
    "web-vitals": "^1.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint-config-prettier": "^8.3.0",
